<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=2.0, user-scalable=yes">
    <title>Dharmagarden - Abode</title>
    <style>
        /* ========== RESET & BASE ========== */
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        body {
            background: linear-gradient(135deg, #1a4d2a, #2d6a3f);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 12px;
            font-family: 'Segoe UI', 'Georgia', serif;
        }

        .page-wrapper {
            max-width: 1100px;
            width: 100%;
            background: #2c5a2e;
            border-radius: 40px;
            padding: 15px;
            box-shadow: 0 20px 40px rgba(0,0,0,0.3);
            border: 2px solid #d4af37;
            display: flex;
            flex-direction: column;
            height: auto;
            min-height: 0;
        }

        /* ========== HEADER TITLE ========== */
        .header-section {
            text-align: center;
            padding: 10px 0 15px 0;
            border-bottom: 2px solid #d4af37;
            margin-bottom: 15px;
            flex-shrink: 0;
        }

        .main-title {
            color: #ffd700;
            font-size: 1.5em;
            font-weight: bold;
            text-shadow: 2px 2px 0 #2c2e1e;
            margin: 0;
            letter-spacing: 2px;
        }

        .main-subtitle {
            color: #fdf0d8;
            font-size: 1.0em;
            margin: 5px 0 0 0;
            opacity: 0.9;
            font-style: italic;
        }

        /* ========== MAP CONTAINER ========== */
        .menu-map-wrapper {
            position: relative;
            width: 100%;
            background: #2c5a2e;
            border-radius: 24px;
            overflow: hidden;
            border: 2px solid #b8860b;
            box-shadow: inset 0 0 30px rgba(0,0,0,0.3);
            flex-shrink: 0;
        }

        .image-container {
            position: relative;
            width: 100%;
            background: #2c5a2e;
            overflow: hidden;
        }

        .menu-bg-image {
            width: 100%;
            height: auto;
            display: block;
            background: #2c5a2e;
            border-radius: 0;
            image-rendering: auto;
        }

        #spriteLayer {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            pointer-events: none;
        }

        /* ========== SPRITE STYLES ========== */
        .menu-sprite {
            position: absolute;
            transform: translate(-50%, -50%);
            cursor: pointer;
            z-index: 10;
            transition: all 0.3s ease;
            filter: drop-shadow(0 4px 8px rgba(0,0,0,0.4));
            -webkit-tap-highlight-color: transparent;
            pointer-events: auto;
            background: none;
            border: none;
            border-radius: 0;
            opacity: 1;
        }

        .menu-sprite.hidden-sprite {
            opacity: 0;
            pointer-events: none;
            transform: translate(-50%, -50%) scale(0.8);
        }

        .menu-sprite.visible-sprite {
            opacity: 1;
            pointer-events: auto;
            transform: translate(-50%, -50%) scale(1);
            animation: spriteReveal 0.5s ease forwards;
        }

        @keyframes spriteReveal {
            0% { opacity: 0; transform: translate(-50%, -50%) scale(0.5); }
            100% { opacity: 1; transform: translate(-50%, -50%) scale(1); }
        }

        .menu-sprite.gate-sprite {
            z-index: 20;
            animation: gatePulse 1.2s ease-in-out infinite;
        }

        .menu-sprite.gate-sprite.entered {
            animation: none;
            filter: drop-shadow(0 4px 8px rgba(0,0,0,0.4));
        }

        @keyframes gatePulse {
            0%, 100% { 
                filter: drop-shadow(0 4px 8px rgba(0,0,0,0.4)) drop-shadow(0 0 15px rgba(255,215,0,0.3));
                transform: translate(-50%, -50%) scale(1);
            }
            50% { 
                filter: drop-shadow(0 4px 8px rgba(0,0,0,0.4)) drop-shadow(0 0 40px rgba(255,215,0,0.8)) drop-shadow(0 0 80px rgba(255,215,0,0.4));
                transform: translate(-50%, -50%) scale(1.05);
            }
        }

        .menu-sprite:hover {
            transform: translate(-50%, -50%) scale(1.15) !important;
            filter: drop-shadow(0 0 20px rgba(255, 215, 0, 0.8)) !important;
            z-index: 30;
        }

        .menu-sprite:active {
            transform: translate(-50%, -50%) scale(0.95) !important;
        }

        .menu-sprite.touched {
            transform: translate(-50%, -50%) scale(1.1) !important;
            filter: drop-shadow(0 0 25px rgba(255, 215, 0, 0.9)) !important;
        }

        /* ========== FOOTER / SCROLL BOX ========== */
        .footer-content-box {
            margin-top: 15px;
            background: #fdf0d8;
            border-radius: 16px;
            border: 3px solid #b8860b;
            padding: 5px;
            width: 100%;
            box-sizing: border-box;
            flex-shrink: 0;
        }

        .footer-inner {
            background: #fef8e7;
            border-radius: 12px;
            padding: 7px 10px;
            min-height: 50px;
            max-height: 100px;
            overflow-y: auto;
            font-family: 'Georgia', 'Times New Roman', serif;
            color: #3b2a1f;
        }

        .footer-inner::-webkit-scrollbar {
            width: 6px;
        }
        .footer-inner::-webkit-scrollbar-track {
            background: #e8dcc8;
            border-radius: 4px;
        }
        .footer-inner::-webkit-scrollbar-thumb {
            background: #b8860b;
            border-radius: 4px;
        }

        .footer-title {
            color: #b45f06;
            font-size: 16px;
            font-weight: bold;
            margin-bottom: 2px;
        }

        .footer-text {
            font-size: 14px;
            line-height: 1.4;
            color: #3b2a1f;
        }

        /* ========== VIDEO MODAL ========== */
        .video-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.85);
            z-index: 9999;
            justify-content: center;
            align-items: center;
            padding: 20px;
            box-sizing: border-box;
        }

        .video-container {
            position: relative;
            width: 100%;
            max-width: 800px;
            aspect-ratio: 16 / 9;
            background: #000;
            border: 3px solid #d4af37;
            border-radius: 20px;
            overflow: hidden;
        }

        .video-container iframe {
            width: 100%;
            height: 100%;
            border: none;
        }

        .close-modal-btn {
            position: absolute;
            top: -44px;
            right: 0;
            background: #8b0000;
            color: white;
            border: none;
            padding: 6px 16px;
            font-weight: bold;
            cursor: pointer;
            border-radius: 30px;
            font-size: 14px;
            transition: background 0.2s;
            z-index: 10;
        }

        .close-modal-btn:hover {
            background: #ff0000;
        }

        /* ========== GUARDIAN OVERLAY ========== */
        .guardian-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 10000;
            justify-content: center;
            align-items: center;
            padding: 10px;
            box-sizing: border-box;
            background: rgba(0, 0, 0, 0.3);
            animation: overlayFadeIn 0.4s ease;
        }

        .guardian-overlay.active {
            display: flex;
        }

        @keyframes overlayFadeIn {
            from { opacity: 0; }
            to { opacity: 1; }
        }

        .guardian-png {
            max-width: 95%;
            max-height: 85vh;
            width: auto;
            height: auto;
            cursor: pointer;
            border-radius: 16px;
            filter: drop-shadow(0 10px 40px rgba(0,0,0,0.5));
            animation: pngPopIn 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
            user-select: none;
            -webkit-user-drag: none;
        }

        @keyframes pngPopIn {
            0% { transform: scale(0.7); opacity: 0; }
            100% { transform: scale(1); opacity: 1; }
        }

        /* ========== MASCOT + SPEECH BUBBLE POPUP ========== */
        .mascot-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            z-index: 9998;
            justify-content: center;
            align-items: center;
            padding: 10px;
            box-sizing: border-box;
            background: rgba(0, 0, 0, 0.2);
            animation: overlayFadeIn 0.3s ease;
        }

        .mascot-overlay.active {
            display: flex;
        }

        .mascot-container {
            display: flex;
            flex-direction: row;
            align-items: center;
            gap: 12px;
            max-width: 550px;
            width: 100%;
            animation: pngPopIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
            position: relative;
        }

        .mascot-image {
            flex: 0 0 auto;
            width: 100px;
            height: auto;
            max-height: 160px;
            filter: drop-shadow(0 4px 15px rgba(0,0,0,0.3));
            user-select: none;
            -webkit-user-drag: none;
            cursor: default;
            border-radius: 12px;
        }

        .speech-bubble {
            flex: 1;
            background: #fff8e7;
            padding: 14px 18px 14px 20px;
            border-radius: 18px 18px 18px 6px;
            position: relative;
            box-shadow: 0 0 0 2px #d4af37, 0 0 0 5px #8B6914, 0 10px 30px rgba(0,0,0,0.25);
            min-height: 90px;
            display: flex;
            flex-direction: column;
            justify-content: center;
        }

        .speech-bubble::before {
            content: '';
            position: absolute;
            left: -14px;
            top: 30px;
            border: 9px solid transparent;
            border-right-color: #fff8e7;
            z-index: 2;
        }

        .speech-bubble::after {
            content: '';
            position: absolute;
            left: -19px;
            top: 27px;
            border: 11px solid transparent;
            border-right-color: #d4af37;
            z-index: 1;
        }

        .speech-bubble .bubble-icon {
            display: none;
        }

        .speech-bubble .bubble-title {
            color: #5a3e0e;
            font-size: 1.1em;
            font-weight: bold;
            font-family: 'Georgia', serif;
            margin-bottom: 2px;
            line-height: 1.2;
        }

        .speech-bubble .bubble-description {
            font-size: 0.85em;
            color: #3b2a1f;
            line-height: 1.3;
            margin: 3px 0 6px 0;
        }

        .speech-bubble .bubble-actions {
            display: flex;
            gap: 10px;
            align-items: center;
            flex-wrap: wrap;
            margin-top: 2px;
        }

        .speech-bubble .enter-btn {
            background: linear-gradient(145deg, #8B6914, #6B4F0E);
            color: white;
            border: none;
            padding: 6px 20px;
            border-radius: 30px;
            font-size: 0.9em;
            font-weight: bold;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 3px 10px rgba(139, 105, 20, 0.3);
            font-family: 'Georgia', serif;
            flex-shrink: 0;
        }

        .speech-bubble .enter-btn:hover {
            transform: scale(1.05);
            box-shadow: 0 4px 15px rgba(139, 105, 20, 0.4);
        }

        .speech-bubble .enter-btn:active {
            transform: scale(0.95);
        }

        .speech-bubble .close-hint {
            font-size: 0.7em;
            color: #8a7a6a;
            font-style: italic;
        }

        .speech-bubble .close-btn {
            position: absolute;
            top: 5px;
            right: 10px;
            background: none;
            border: none;
            font-size: 18px;
            cursor: pointer;
            color: #8B6914;
            transition: transform 0.2s;
            line-height: 1;
            padding: 2px;
        }

        .speech-bubble .close-btn:hover {
            transform: scale(1.2);
        }

        /* Mobile: stack vertically, more compact */
        @media (max-width: 600px) {
            .mascot-container {
                flex-direction: column;
                align-items: center;
                gap: 6px;
                max-width: 320px;
            }

            .mascot-image {
                width: 70px;
                max-height: 100px;
                padding: 4px;
            }

            .speech-bubble {
                padding: 10px 12px 12px 14px;
                border-radius: 14px 14px 14px 4px;
                min-height: 70px;
                width: 100%;
            }

            .speech-bubble::before {
                left: 20px;
                top: -12px;
                border: 7px solid transparent;
                border-bottom-color: #fff8e7;
                border-right-color: transparent;
            }

            .speech-bubble::after {
                left: 17px;
                top: -16px;
                border: 9px solid transparent;
                border-bottom-color: #d4af37;
                border-right-color: transparent;
            }

            .speech-bubble .bubble-title {
                font-size: 0.9em;
                margin-bottom: 1px;
            }
            .speech-bubble .bubble-description {
                font-size: 0.75em;
                margin: 2px 0 4px 0;
                line-height: 1.2;
            }
            .speech-bubble .enter-btn {
                font-size: 0.75em;
                padding: 4px 14px;
            }
            .speech-bubble .close-hint {
                font-size: 0.6em;
            }
            .speech-bubble .close-btn {
                font-size: 14px;
                top: 3px;
                right: 7px;
            }
        }

        @media (max-width: 400px) {
            .mascot-container {
                max-width: 280px;
                gap: 4px;
            }
            .mascot-image {
                width: 60px;
                max-height: 80px;
            }
            .speech-bubble {
                padding: 8px 10px 10px 12px;
                min-height: 60px;
            }
            .speech-bubble .bubble-title {
                font-size: 0.8em;
            }
            .speech-bubble .bubble-description {
                font-size: 0.65em;
            }
            .speech-bubble .enter-btn {
                font-size: 0.7em;
                padding: 3px 12px;
            }
            .speech-bubble .close-btn {
                font-size: 12px;
            }
            .speech-bubble::before {
                left: 16px;
                top: -10px;
                border: 6px solid transparent;
                border-bottom-color: #fff8e7;
                border-right-color: transparent;
            }
            .speech-bubble::after {
                left: 13px;
                top: -13px;
                border: 8px solid transparent;
                border-bottom-color: #d4af37;
                border-right-color: transparent;
            }
        }

        @media (max-height: 500px) and (orientation: landscape) {
            .mascot-container {
                flex-direction: row;
                gap: 10px;
                max-width: 450px;
            }
            .mascot-image {
                width: 70px;
                max-height: 110px;
            }
            .speech-bubble {
                padding: 10px 14px 12px 16px;
                min-height: 70px;
            }
            .speech-bubble::before {
                left: -12px;
                top: 25px;
                border: 7px solid transparent;
                border-right-color: #fff8e7;
            }
            .speech-bubble::after {
                left: -16px;
                top: 22px;
                border: 9px solid transparent;
                border-right-color: #d4af37;
            }
            .speech-bubble .bubble-title {
                font-size: 0.9em;
            }
            .speech-bubble .bubble-description {
                font-size: 0.75em;
            }
            .speech-bubble .enter-btn {
                font-size: 0.75em;
                padding: 4px 14px;
            }
        }
    </style>
</head>

<body>

    <div class="page-wrapper">

        <!-- ========== HEADER ========== -->
        <div class="header-section">
            <div class="main-title">🏯 Dharmagarden</div>
            <div class="main-subtitle">Welcome to our humble abode</div>
        </div>

        <!-- ========== MAP CONTAINER ========== -->
        <div class="menu-map-wrapper">
            <div class="image-container">
                <img class="menu-bg-image" src="abode/mainabode.jpg" alt="Dharmagarden Main abode" id="bgImage">
                <div id="spriteLayer"></div>
            </div>
        </div>

        <!-- ========== FOOTER / SCROLL BOX ========== -->
        <div class="footer-content-box">
            <div class="footer-inner">
                <div class="footer-title" id="infoTitle">🏯 Welcome to Dharmagarden</div>
                <div class="footer-text" id="infoText">Please tap the glowing gate to enter!</div>
            </div>
        </div>

    </div>

    <!-- ========== GUARDIAN PNG OVERLAY ========== -->
    <div class="guardian-overlay" id="guardianOverlay">
        <img class="guardian-png" 
             src="abode/gategod.png"
             alt="Gate Guardian 门神" 
             id="guardianPng">
    </div>

    <!-- ========== MASCOT + SPEECH BUBBLE POPUP ========== -->
    <div class="mascot-overlay" id="mascotOverlay">
        <div class="mascot-container">
            <img class="mascot-image" 
                 src="" 
                 alt="Mascot" 
                 id="mascotImage">
            <div class="speech-bubble" id="speechBubble">
                <button class="close-btn" id="bubbleCloseBtn">✕</button>
                <div class="bubble-icon" id="bubbleIcon">🏯</div>
                <div class="bubble-title" id="bubbleTitle">Location Name</div>
                <div class="bubble-description" id="bubbleDescription">Description goes here...</div>
                <div class="bubble-actions">
                    <button class="enter-btn" id="bubbleEnterBtn">🚪 Enter</button>
                    <span class="close-hint">✕ click to close</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ========== VIDEO MODAL ========== -->
    <div id="videoModal" class="video-modal">
        <div class="video-container">
            <button class="close-modal-btn" id="closeModal">✕ CLOSE</button>
            <iframe id="videoPlayer" src="" referrerpolicy="strict-origin-when-cross-origin" allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share" allowfullscreen></iframe>
        </div>
    </div>

    <script>
        // ============================================================
        // CONFIGURATION
        // ============================================================

        const menuSprites = [
            {
                id: 1,
