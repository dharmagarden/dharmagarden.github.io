                mascot: "abode/fruttii/fruttiitummy.png"
            },
            {
                id: 5,
                name: "📚 Sunshine Lotus School",
                description: "Find your courses, projects and talks.",
                topPercent: 38,
                leftPercent: 37.4,
                widthPercent: 20.9,
                spriteIcon: "abode/lotusschool.png",
                actionType: "LINK",
                targetURL: "apology.html",
                isGate: false,
                mascot: "abode/fruttii/fruttiihirun.png"
            },
            {
                id: 6,
                name: "ℹ️ Dharmagarden Infocenter",
                description: "Meet Bodhi Fruittee there. He can tell you more about the temple.",
                topPercent: 48.5,
                leftPercent: 24.7,
                widthPercent: 20.1,
                spriteIcon: "abode/infocenter.png",
                actionType: "LINK",
                targetURL: "infocenter.html",
                isGate: false,
                mascot: "abode/fruttii/fruttiianjali1.png"
            },
            {
                id: 7,
                name: "🌳 Bodhi Tree Shrine",
                description: "Join puja under this majestic Bodhi Tree.",
                topPercent: 66.5,
                leftPercent: 51.1,
                widthPercent: 24.3,
                spriteIcon: "abode/bodhishrine.png",
                actionType: "LINK",
                targetURL: "apology.html",
                isGate: false,
                mascot: "abode/fruttii/fruttiianjali1.png"
            },
            {
                id: 8,
                name: "Dharmagarden Temple Gate",
                description: "Auspicious main gate into the temple.",
                topPercent: 70.5,
                leftPercent: 26.1,
                widthPercent: 19.4,
                spriteIcon: "abode/abodegate.png",
                actionType: "GATE",
                targetURL: "",
                isGate: true,
                mascot: null
            },            
            {
               id: 9,
               name: "🎨 Joyous Heart Gallery",
               description: "An exhibition of selected works.",
               topPercent: 58.7,
               leftPercent: 68.9,
               widthPercent: 21.9,
               spriteIcon: "abode/heartgallery.png",
                actionType: "VIDEO",
                targetURL: "https://www.youtube.com/embed/UnQASwhsryM",
                isGate: false,
                mascot: "abode/fruttii/fruttiirunright.png"
            }           
        ];

        // ============================================================
        // STATE MANAGEMENT
        // ============================================================

        let templeEntered = false;
        let currentSprite = null;

        function saveTempleState() {
            try {
                sessionStorage.setItem('templeEntered', JSON.stringify(templeEntered));
            } catch (e) {
                console.warn('Could not save state:', e);
            }
        }

        function loadTempleState() {
            try {
                const saved = sessionStorage.getItem('templeEntered');
                if (saved !== null) {
                    templeEntered = JSON.parse(saved);
                    return templeEntered;
                }
            } catch (e) {
                console.warn('Could not load state:', e);
            }
            return false;
        }

        window.addEventListener('beforeunload', function(e) {
            saveTempleState();
        });

        function navigateTo(url) {
            console.log('🌐 Navigating to:', url);
            saveTempleState();
            
            if (isInIframe) {
                try {
                    if (window.top && window.top !== window) {
                        window.top.location.href = url;
                    } else {
                        window.open(url, '_blank');
                    }
                } catch (e) {
                    window.open(url, '_blank');
                }
            } else {
                window.location.href = url;
            }
        }

        // ============================================================
        // TOUCH DETECTION
        // ============================================================

        let isTouchDevice = false;
        
        if ('ontouchstart' in window) {
            isTouchDevice = true;
        } else if (navigator.maxTouchPoints > 0) {
            isTouchDevice = true;
        } else if (window.matchMedia && window.matchMedia('(pointer: coarse)').matches) {
            isTouchDevice = true;
        }
        
        if (window.matchMedia && window.matchMedia('(pointer: fine)').matches) {
            const hasTouch = 'ontouchstart' in window;
            const hasHover = window.matchMedia('(hover: hover)').matches;
            const hasCoarsePointer = window.matchMedia('(pointer: coarse)').matches;
            
            if (hasHover && !hasCoarsePointer) {
                isTouchDevice = false;
            } else if (hasHover && hasTouch) {
                isTouchDevice = false;
            }
        }

        console.log('🖱️ Touch device detected:', isTouchDevice);

        // ============================================================
        // GATE ENTRY SYSTEM
        // ============================================================

        function showGuardianOverlay() {
            const overlay = document.getElementById('guardianOverlay');
            overlay.classList.add('active');
            document.body.style.overflow = 'hidden';
            console.log('🛡️ Showing guardian overlay');
        }

        function enterTemple() {
            const overlay = document.getElementById('guardianOverlay');
            overlay.classList.remove('active');
            document.body.style.overflow = '';
            templeEntered = true;
            
            saveTempleState();
            
            const gateSprite = document.querySelector('.menu-sprite.gate-sprite');
            if (gateSprite) {
                gateSprite.classList.add('entered');
            }
            
            const hiddenSprites = document.querySelectorAll('.menu-sprite.hidden-sprite');
            hiddenSprites.forEach((sprite, index) => {
                setTimeout(() => {
                    sprite.classList.remove('hidden-sprite');
                    sprite.classList.add('visible-sprite');
                }, index * 60);
            });
            
            document.getElementById('infoTitle').innerText = '🪷 Welcome to Dharmagarden';
            document.getElementById('infoText').innerText = '👆 Click a location to learn more!';
            
            console.log('🚪 Temple gates opened!');
        }

        document.getElementById('guardianPng').addEventListener('click', enterTemple);
        
        document.getElementById('guardianOverlay').addEventListener('click', (e) => {
            if (e.target === document.getElementById('guardianOverlay')) {
                enterTemple();
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && document.getElementById('guardianOverlay').classList.contains('active')) {
                enterTemple();
            }
        });

        // ============================================================
        // MASCOT + SPEECH BUBBLE FUNCTIONS
        // ============================================================

        function showMascotPopup(sprite) {
            currentSprite = sprite;
            
            const mascotImg = document.getElementById('mascotImage');
            if (sprite.mascot) {
                mascotImg.src = sprite.mascot;
                mascotImg.style.display = 'block';
            } else {
                mascotImg.style.display = 'none';
            }
            
            document.getElementById('bubbleTitle').textContent = sprite.name;
            document.getElementById('bubbleDescription').textContent = sprite.description;
            
            const enterBtn = document.getElementById('bubbleEnterBtn');
            if (sprite.actionType === 'VIDEO') {
                enterBtn.textContent = '🎬 Watch';
            } else {
                enterBtn.textContent = '🚪 Enter';
            }
            
            const overlay = document.getElementById('mascotOverlay');
            overlay.classList.add('active');
            document.body.style.overflow = 'hidden';
            
            console.log('📖 Showing mascot for:', sprite.name);
        }

        function closeMascotPopup() {
            const overlay = document.getElementById('mascotOverlay');
            overlay.classList.remove('active');
            document.body.style.overflow = '';
            console.log('❌ Mascot popup closed');
        }

        function activateCurrentSprite() {
            if (!currentSprite) {
                console.warn('⚠️ No current sprite to activate!');
                return;
            }
            
            console.log('🎯 Activating sprite:', currentSprite.name);
            
            const spriteToActivate = currentSprite;
            closeMascotPopup();
            
            if (spriteToActivate.actionType === "LINK") {
                navigateTo(spriteToActivate.targetURL);
            } else if (spriteToActivate.actionType === "VIDEO") {
                console.log('🎬 Opening video:', spriteToActivate.targetURL);
                openVideoModal(spriteToActivate.targetURL);
            }
            
            currentSprite = null;
        }

        // Popup event listeners
        document.getElementById('bubbleCloseBtn').addEventListener('click', (e) => {
            e.stopPropagation();
            closeMascotPopup();
            currentSprite = null;
        });

        document.getElementById('bubbleEnterBtn').addEventListener('click', (e) => {
            e.stopPropagation();
            console.log('🚪 Enter button clicked!');
            activateCurrentSprite();
        });

        document.getElementById('mascotOverlay').addEventListener('click', (e) => {
            if (e.target === document.getElementById('mascotOverlay')) {
                closeMascotPopup();
                currentSprite = null;
            }
        });

        document.addEventListener('keydown', (e) => {
            if (e.key === 'Escape' && document.getElementById('mascotOverlay').classList.contains('active')) {
                closeMascotPopup();
                currentSprite = null;
            }
        });

        // ============================================================
        // BUILD MENU
        // ============================================================

        const isInIframe = window !== window.top;

        function buildMenu() {
            const layer = document.getElementById("spriteLayer");
            layer.innerHTML = '';

            menuSprites.forEach(sprite => {
                const img = document.createElement("img");
                img.className = "menu-sprite";
                img.src = sprite.spriteIcon;
                img.alt = sprite.name;
                img.style.top = sprite.topPercent + "%";
                img.style.left = sprite.leftPercent + "%";
                img.style.width = sprite.widthPercent + "%";
                img.dataset.spriteId = sprite.id;
                img.dataset.isGate = sprite.isGate ? 'true' : 'false';

                if (!sprite.isGate) {
                    img.classList.add('hidden-sprite');
                } else {
                    img.classList.add('gate-sprite');
                }

                img.addEventListener("mouseenter", () => {
                    if (templeEntered || sprite.isGate) {
                        updateFooter(sprite.name, sprite.description);
                    }
                });

                img.addEventListener("click", (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    
                    if (!sprite.isGate && !templeEntered) {
                        img.style.transform = 'translate(-50%, -50%) scale(0.9)';
                        setTimeout(() => {
                            img.style.transform = '';
                        }, 200);
                        return;
                    }

                    if (sprite.isGate) {
                        console.log('🚪 Gate clicked!');
                        if (!templeEntered) {
                            showGuardianOverlay();
                        }
                        return;
                    }

                    console.log('🖱️ Click on:', sprite.name);
                    
                    if (document.getElementById('mascotOverlay').classList.contains('active')) {
                        closeMascotPopup();
                    }
                    
                    setTimeout(() => {
                        showMascotPopup(sprite);
                        updateFooter(sprite.name, 'Click "Enter" to visit');
                    }, 50);
                    
                    img.classList.add('touched');
                    setTimeout(() => {
                        img.classList.remove('touched');
                    }, 200);
                });

                img.addEventListener("contextmenu", (e) => {
                    e.preventDefault();
                });

                img.addEventListener("touchstart", (e) => {
                    if (!sprite.isGate && !templeEntered) {
                        e.preventDefault();
                    }
                }, { passive: false });

                layer.appendChild(img);
            });
        }

        function updateFooter(title, text) {
            document.getElementById("infoTitle").innerText = title;
            document.getElementById("infoText").innerText = text;
        }

        function resetFooter() {
            if (!templeEntered) {
                document.getElementById("infoTitle").innerText = "🏯 Dharmagarden";
                document.getElementById("infoText").innerText = "✨ Click the glowing gate to enter!";
            } else {
                document.getElementById("infoTitle").innerText = "🪷 Welcome to Dharmagarden";
                document.getElementById("infoText").innerText = "👆 Click a location to learn more!";
            }
        }

        // Video modal functions
        const modal = document.getElementById("videoModal");
        const player = document.getElementById("videoPlayer");

        function openVideoModal(embedURL) {
            player.src = embedURL + "?autoplay=1&rel=0";
            modal.style.display = "flex";
            document.body.style.overflow = "hidden";
        }

        function closeVideoModal() {
            modal.style.display = "none";
            player.src = "";
            document.body.style.overflow = "";
        }

        document.getElementById("closeModal").addEventListener("click", closeVideoModal);
        modal.addEventListener("click", (e) => {
            if (e.target === modal) closeVideoModal();
        });

        document.addEventListener("keydown", (e) => {
            if (e.key === "Escape") closeVideoModal();
        });

        document.addEventListener('click', (e) => {
            if (!e.target.closest('.menu-sprite') && !e.target.closest('.mascot-container')) {
                if (templeEntered) {
                    resetFooter();
                }
            }
        });

        // ============================================================
        // INITIALIZE
        // ============================================================

        function initializePage() {
            const savedState = loadTempleState();
            
            if (savedState) {
                templeEntered = true;
                console.log('🔄 Restoring temple state');
            }
            
            buildMenu();
            
            if (templeEntered) {
                const gateSprite = document.querySelector('.menu-sprite.gate-sprite');
                if (gateSprite) {
                    gateSprite.classList.add('entered');
                }
                
                const hiddenSprites = document.querySelectorAll('.menu-sprite.hidden-sprite');
                hiddenSprites.forEach((sprite) => {
                    sprite.classList.remove('hidden-sprite');
                    sprite.classList.add('visible-sprite');
                });
                
                document.getElementById('infoTitle').innerText = '🪷 Welcome to Dharmagarden';
                document.getElementById('infoText').innerText = '👆 Click a location to learn more!';
                console.log('🔄 Temple state restored');
            }
            
            setTimeout(() => {
                resetFooter();
                console.log('🏯 Dharmagarden loaded!');
                console.log('💡 Temple entered:', templeEntered);
                console.log('💡 Click a shrine → Mascot with speech bubble appears');
                console.log('💡 Click Enter to visit, ✕ or ESC to close');
            }, 100);
        }

        initializePage();
    </script>

</body>
